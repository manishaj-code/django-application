# Environment for `docker compose --env-file .env.docker up`.
# Copy to .env.docker (git-ignored) and replace every placeholder.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
SITE_NAME=Django CMS
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
HTTP_PORT=8080

DB_NAME=django_cms
DB_USER=django_cms_user
DB_PASSWORD=change-me
# The bundled PostgreSQL container has no TLS; use require/verify-full with a managed DB.
DB_SSLMODE=disable

CACHE_URL=dbcache://django_cache

# Emails are printed to `docker compose logs web` until SMTP is configured.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@localhost

# ---------------------------------------------------------------------------
# LOCAL TRIAL OVER PLAIN HTTP ONLY. On a real server with HTTPS, delete these
# four lines so the secure defaults apply (HTTPS redirect, secure cookies, HSTS).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
# ---------------------------------------------------------------------------

LOG_LEVEL=INFO
WEB_CONCURRENCY=3
