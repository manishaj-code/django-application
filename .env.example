# Copy to .env and fill in real values. NEVER commit .env.
# Values here are placeholders only.

# --- Core -------------------------------------------------------------------
# Generate with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-to-a-long-random-string
# True only on your own machine. Must be False in production.
DEBUG=False
# Comma-separated host names the site is served on.
ALLOWED_HOSTS=example.com,www.example.com
# Comma-separated origins (with scheme) allowed to POST forms over HTTPS.
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SITE_NAME=Django CMS
# Path of the admin panel; changing it from the default reduces bot noise.
ADMIN_URL=admin/
TIME_ZONE=UTC

# --- PostgreSQL ---------------------------------------------------------------
DB_NAME=django_cms
DB_USER=django_cms_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# --- Cache (rate limiting) ------------------------------------------------
# Database cache needs:  python manage.py createcachetable
CACHE_URL=dbcache://django_cache

# --- Email (password reset, contact notifications) ------------------------
# Development: print emails to the terminal instead of sending them:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# or write them to files in EMAIL_FILE_PATH:
#   EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@example.com
SERVER_EMAIL=no-reply@example.com
# Optional: also email contact-form messages to this address.
CONTACT_RECIPIENT_EMAIL=

# --- HTTPS / proxy (production) ---------------------------------------------
SECURE_SSL_REDIRECT=True
# Seconds browsers must remember to use HTTPS. Start small (3600), raise to
# 31536000 once HTTPS is confirmed working.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Set True only when a trusted proxy/load balancer terminates TLS and sets
# X-Forwarded-Proto (nginx in compose.yaml, most PaaS routers).
USE_X_FORWARDED_PROTO=False
# Number of trusted proxies in front of the app (for client IP detection).
NUM_PROXIES=0

# --- Uploads ------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5
# MEDIA_ROOT=/var/www/django_cms/media

# --- Rate limits ("<count>/<s|m|h|d>") ----------------------------------------
RATELIMIT_ENABLED=True
RATELIMIT_LOGIN=10/m
RATELIMIT_REGISTER=10/h
RATELIMIT_PASSWORD_RESET=5/h
RATELIMIT_CONTACT=10/h

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Gunicorn -----------------------------------------------------------------
PORT=8000
WEB_CONCURRENCY=3
